<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CraftingLocationFormatter.cs" Link="CraftingLocationFormatter.cs" />
    <Compile Include="..\..\src\LocationQualifierLocalization.cs" Link="LocationQualifierLocalization.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\lang\refugee_camp.*.txt" Link="lang\%(Filename)%(Extension)">
      <LogicalName>CompactCraftingTooltips.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
